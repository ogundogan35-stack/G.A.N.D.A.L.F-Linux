# =====================================================================
# Project Gandalf - configuration template
# Copy this file to ".env" and fill in YOUR OWN keys. Never commit .env.
# =====================================================================

# ---- AI BRAIN (required: at least one) ----
# Primary brain (Gemini). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model (e.g. gemini-3-flash-preview)
#GEMINI_MODEL=

# Fallback brain (OpenRouter, GPT-4o-mini used if Gemini is down/out).
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- TELEGRAM (optional remote control) ----
# Create a bot with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN=

# Restrict the bot to a single authorized chat (your numeric chat id).
# Leave empty to allow any user who messages the bot.
TELEGRAM_CHAT_ID=

# ---- SPOTIFY (optional music control) ----
# Create an app: https://developer.spotify.com/dashboard  -> Settings -> User auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI you registered in the dashboard:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ---- WEB DASHBOARD (optional) ----
# Local network HUD port (default 5000).
#DASHBOARD_PORT=5000

# ---- HAND GESTURE CONTROL (optional override) ----
# Path to the WindowGesture window_gesture.py script, if not bundled.
#HAND_GESTURE_CONTROL_SCRIPT=/path/to/window_gesture.py

# ---- HOMEWORK JSON (optional override, Linux) ----
# Default on Linux: <project>/egitim/odev/odevler.json
#HOMEWORK_JSON=/abs/path/odevler.json
